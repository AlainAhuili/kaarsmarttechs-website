---
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import type { ComponentProps } from "astro/types";
import Icon from "../components/Icon.astro";
import SorterLine from "../components/SorterLine.astro";
import { fill, localePath, useDict, type Lang } from "../i18n";

type IconName = ComponentProps<typeof Icon>["name"];

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const dict = useDict(lang);
const t = dict.home;
const email = "hello@kaarsmarttechs.com";

// Icons for the four technical pillars, in the order of t.capabilities.
const capabilityIcons: IconName[] = ["eye", "chip", "network", "cloud"];
const capabilities = t.capabilities.map((c, i) => ({ ...c, icon: capabilityIcons[i]! }));

// The four projects featured on the home page; texts come from t.featured.
const featuredIcons = {
  "lego-sorting-system": "cube",
  "travel-hygienic-wc-seat-frame": "hygiene",
  "solar-led-wireframe-sculptures": "solar",
  "embedded-vision-toolkit": "network",
} satisfies Record<keyof typeof t.featured, IconName>;
const featured = await Promise.all(
  (Object.keys(featuredIcons) as (keyof typeof featuredIcons)[]).map(async (slug) => ({
    slug,
    icon: featuredIcons[slug],
    ...t.featured[slug],
    project: (await getEntry("projects", `${lang}/${slug}`))!,
  })),
);
---

<Base lang={lang} title="Kaar Smart Techs" description={t.description}>
  <section class="hero" id="hero">
    <div class="orb orb-a"></div>
    <div class="orb orb-b"></div>
    <div class="wrap hero-inner">
      <div class="emblem">
        <img src="/logo.png" width="113" height="96" alt="" />
      </div>
      <p class="badge">
        <Icon name="chip" size={16} />
        {t.badge}
      </p>
      <h1>
        Kaar <span class="gradient">Smart Techs</span>
      </h1>
      <p class="motto" lang="en">
        "Innovating Tomorrow, Connected Today"
      </p>
      <p class="intro">{t.intro}</p>
      <div class="actions">
        <a class="button" href="#capabilities">
          {t.explore} <Icon name="arrow" size={18} />
        </a>
        <a class="button secondary" href={localePath(lang, "/contact/")}>
          {t.partner}
        </a>
      </div>
      <div class="line">
        <SorterLine lang={lang} />
      </div>
      <ul class="stats">
        {t.stats.map((s) => (
          <li>
            <strong>{s.value}</strong>
            <span>{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="capabilities">
    <div class="wrap">
      <div class="heading">
        <p class="eyebrow">{t.capabilitiesEyebrow}</p>
        <h2>{t.capabilitiesTitle}</h2>
        <p>{t.capabilitiesText}</p>
      </div>
      <ul class="cards capabilities">
        {capabilities.map((c) => (
          <li class="card">
            <div class="card-body">
              <span class="icon">
                <Icon name={c.icon} size={28} />
              </span>
              <h3>{c.name}</h3>
              <p>{c.text}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="all">
        <a href={localePath(lang, "/services/")}>{t.howWeWork}</a>
      </p>
    </div>
  </section>

  <section class="section band" id="innovations">
    <div class="wrap">
      <div class="heading">
        <p class="eyebrow">{t.portfolioEyebrow}</p>
        <h2>{t.portfolioTitle}</h2>
        <p>{t.portfolioText}</p>
      </div>
      <ul class="cards">
        {featured.map(({ slug, project, icon, tag, highlights }) => (
          <li class="card">
            <div class="card-body">
              <div class="card-top">
                <span class="icon">
                  <Icon name={icon} size={28} />
                </span>
                <span class="tag">{tag}</span>
              </div>
              <h3>
                <a href={localePath(lang, `/projects/${slug}/`)}>{project.data.title}</a>
              </h3>
              <p>{project.data.tagline}</p>
              <ul class="highlights">
                {highlights.map((h) => (
                  <li>
                    <Icon name="check" size={16} />
                    {h}
                  </li>
                ))}
              </ul>
            </div>
            <div class="card-foot">
              <span>{fill(t.statusLabel, { status: dict.status[project.data.status] })}</span>
              <span class="more" aria-hidden="true">
                {t.caseStudy} <Icon name="chevron" size={14} />
              </span>
            </div>
          </li>
        ))}
      </ul>
      <p class="all">
        <a href={localePath(lang, "/projects/")}>{t.seeAll}</a>
      </p>
    </div>
  </section>

  <section class="section" id="about">
    <div class="wrap about">
      <div>
        <p class="eyebrow">{t.aboutEyebrow}</p>
        <h2>{t.aboutTitle}</h2>
        <p>
          {t.aboutP1Before} <strong>{t.aboutPlace}</strong>
          {t.aboutP1After}
        </p>
        <p>
          {t.aboutP2}{" "}
          <em class="accent" lang="en">
            "Innovating Tomorrow, Connected Today"
          </em>
          .
        </p>
        <h3 class="advantage">{t.advantage}</h3>
        <div class="pillars">
          {t.pillars.map((p, i) => (
            <div>
              <Icon name={i === 0 ? "shield" : "bolt"} />
              <div>
                <h3>{p.name}</h3>
                <p>{p.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="values-wrap">
        <div class="values">
          <h3>
            <Icon name="target" /> {t.missionTitle}
          </h3>
          <dl>
            {t.values.map((v) => (
              <div>
                <dt>{v.name}</dt>
                <dd>{v.text}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="section band" id="contact">
    <div class="wrap">
      <div class="heading">
        <p class="eyebrow">{t.contactEyebrow}</p>
        <h2>{t.contactTitle}</h2>
        <p>{t.contactText}</p>
      </div>
      <div class="contact">
        <ul class="contact-cards">
          <li>
            <span class="icon">
              <Icon name="pin" size={20} />
            </span>
            <div>
              <h3>{t.hq}</h3>
              <p>
                {t.hqLines[0]}
                <br />
                {t.hqLines[1]}
              </p>
            </div>
          </li>
          <li>
            <span class="icon">
              <Icon name="mail" size={20} />
            </span>
            <div>
              <h3>{t.emailUs}</h3>
              <p>
                <a href={`mailto:${email}`}>{email}</a>
              </p>
            </div>
          </li>
          <li>
            <span class="icon">
              <Icon name="globe" size={20} />
            </span>
            <div>
              <h3>{t.responseTitle}</h3>
              <p>{t.responseText}</p>
            </div>
          </li>
        </ul>
        <div class="contact-panel">
          <h3>{t.panelTitle}</h3>
          <p>{t.panelText}</p>
          <a class="button" href={`mailto:${email}`}>
            {t.send} <Icon name="send" size={18} />
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------------------------------------------------------------- hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 10vw, 8rem) clamp(4rem, 9vw, 7rem);
    text-align: center;
    background-image:
      radial-gradient(circle at 50% 50%, rgb(6 182 212 / 0.05) 0%, transparent 80%),
      linear-gradient(to right, rgb(255 255 255 / 0.02) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.02) 1px, transparent 1px);
    background-size:
      100% 100%,
      40px 40px,
      40px 40px;
  }
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(64px);
    pointer-events: none;
  }
  .orb-a {
    top: 25%;
    left: 50%;
    width: 24rem;
    height: 24rem;
    transform: translate(-50%, -50%);
    background: rgb(6 182 212 / 0.1);
  }
  .orb-b {
    bottom: 2.5rem;
    right: 2.5rem;
    width: 20rem;
    height: 20rem;
    background: rgb(37 99 235 / 0.1);
  }
  .hero-inner {
    position: relative;
  }
  .emblem {
    display: inline-block;
    margin-bottom: 2rem;
    padding: 0.75rem;
    border-radius: var(--radius);
    background: rgb(10 17 40 / 0.8);
    border: 1px solid rgb(6 182 212 / 0.4);
    box-shadow: var(--glow);
  }
  .emblem img {
    display: block;
    width: clamp(5.5rem, 14vw, 7rem);
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: none;
    margin: 0 auto 1.5rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: rgb(6 182 212 / 0.1);
    border: 1px solid rgb(6 182 212 / 0.3);
    color: var(--accent);
    font-size: var(--step--1);
    font-weight: 600;
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.6;
    }
  }
  h1 {
    font-size: clamp(2.5rem, 8vw, 4.75rem);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }
  .gradient {
    background: linear-gradient(to right, var(--accent), var(--accent-blue));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .motto {
    max-width: none;
    margin-bottom: 2rem;
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    font-weight: 300;
    font-style: italic;
    letter-spacing: 0.02em;
    color: #67e8f9;
  }
  .intro {
    max-width: 48rem;
    margin: 0 auto 2.5rem;
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: var(--muted);
  }
  .intro strong {
    color: var(--heading);
    font-weight: 500;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
  .line {
    max-width: 64rem;
    margin: clamp(2.5rem, 6vw, 4rem) auto 0;
  }
  .stats {
    list-style: none;
    margin: clamp(2.5rem, 6vw, 4rem) auto 0;
    padding: 0;
    max-width: 64rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .stats li {
    padding: 1.5rem;
    border-radius: var(--radius);
    background: rgb(10 17 40 / 0.6);
    border: 1px solid var(--rule);
    backdrop-filter: blur(4px);
  }
  .stats strong {
    display: block;
    margin-bottom: 0.25rem;
    font-size: clamp(1.6rem, 3.5vw, 2.25rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--accent);
  }
  .stats span {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--muted);
  }

  /* ------------------------------------------------------- shared section */
  .band {
    background: rgb(10 17 40 / 0.5);
  }
  .heading {
    max-width: 48rem;
    margin: 0 auto 4rem;
    text-align: center;
  }
  .heading p:last-child {
    margin-inline: auto;
    font-size: 1.125rem;
    color: var(--muted);
  }
  .eyebrow {
    margin-bottom: 0.75rem;
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h2 {
    font-size: clamp(1.9rem, 4.5vw, 3rem);
  }
  .icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius);
    background: rgb(6 182 212 / 0.1);
    border: 1px solid rgb(6 182 212 / 0.3);
    color: var(--accent);
  }

  /* ---------------------------------------------------------- portfolio */
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    border-radius: 1.5rem;
    background: var(--bg);
    border: 1px solid var(--rule);
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.3);
    transition: border-color 0.3s;
  }
  .card:hover,
  .card:focus-within {
    border-color: rgb(6 182 212 / 0.5);
  }
  .card-body {
    padding: 2rem;
  }
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .card .icon {
    transition: transform 0.3s;
  }
  .card:hover .icon {
    transform: scale(1.1);
  }
  .tag {
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: rgb(6 182 212 / 0.1);
    border: 1px solid rgb(6 182 212 / 0.2);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: right;
  }
  .card h3 {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .card h3 a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }
  /* The whole card is clickable through the title link. */
  .card h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .card:hover h3 a {
    color: var(--accent);
  }
  .card-body > p {
    font-size: var(--step--1);
    color: var(--muted);
    margin-bottom: 1.5rem;
  }
  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    font-size: var(--step--1);
  }
  .highlights li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .highlights :global(svg) {
    flex-shrink: 0;
    color: var(--accent);
  }
  .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 2rem;
    background: var(--surface);
    border-top: 1px solid var(--rule);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--muted);
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--accent);
  }
  .all {
    margin: 2.5rem 0 0;
    max-width: none;
    text-align: center;
  }

  /* ------------------------------------------------------- capabilities */
  .capabilities .card {
    background: var(--surface);
  }
  .capabilities .icon {
    margin-bottom: 1.5rem;
  }
  .capabilities .card-body > p {
    margin-bottom: 0;
  }

  /* -------------------------------------------------------------- about */
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .about > div > p:not(.eyebrow) {
    color: var(--muted);
  }
  .about strong {
    color: var(--heading);
    font-weight: 600;
  }
  .accent {
    color: #67e8f9;
  }
  .advantage {
    margin: 2rem 0 0;
    font-size: var(--step--1);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .pillars {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 1rem;
  }
  .pillars > div {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .pillars :global(svg) {
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: var(--accent);
  }
  .pillars h3,
  .contact-cards h3 {
    font-size: var(--step--1);
    letter-spacing: 0;
    margin-bottom: 0.25rem;
  }
  .pillars p,
  .contact-cards p {
    margin: 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .values-wrap {
    position: relative;
  }
  .values-wrap::before {
    content: "";
    position: absolute;
    inset: -0.25rem;
    border-radius: 1.5rem;
    background: linear-gradient(to right, #06b6d4, #2563eb);
    opacity: 0.3;
    filter: blur(16px);
  }
  .values {
    position: relative;
    padding: clamp(2rem, 4vw, 2.5rem);
    border-radius: 1.5rem;
    background: var(--surface);
    border: 1px solid rgb(100 116 139 / 0.35);
    box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.5);
  }
  .values h3 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.25rem;
    letter-spacing: 0;
    margin-bottom: 1.5rem;
  }
  .values h3 :global(svg) {
    color: var(--accent);
  }
  .values dl {
    margin: 0;
  }
  .values dl div {
    padding-block: 1rem;
    border-bottom: 1px solid var(--rule);
  }
  .values dl div:first-child {
    padding-top: 0;
  }
  .values dl div:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }
  dt {
    margin-bottom: 0.25rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--heading);
  }
  dd {
    margin: 0;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* ------------------------------------------------------------ contact */
  .contact {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
  }
  .contact-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }
  .contact-cards li {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--bg);
    border: 1px solid var(--rule);
  }
  .contact-cards .icon {
    width: 3rem;
    height: 3rem;
    border-radius: 0.75rem;
  }
  .contact-panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(2rem, 5vw, 2.5rem);
    border-radius: 1.5rem;
    background: var(--bg);
    border: 1px solid var(--rule);
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.3);
  }
  .contact-panel h3 {
    font-size: var(--step-2);
  }
  .contact-panel p {
    color: var(--muted);
    margin-bottom: 2rem;
  }

  /* ------------------------------------------------------------- layout */
  @media (max-width: 56rem) {
    .about,
    .contact {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 48rem) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    .cards {
      grid-template-columns: 1fr;
    }
    .actions .button {
      width: 100%;
    }
  }
  @media (max-width: 30rem) {
    .pillars {
      grid-template-columns: 1fr;
    }
  }
</style>
