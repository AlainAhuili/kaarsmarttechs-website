---
import Base from "../layouts/Base.astro";
import { localePath, useDict, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useDict(lang).services;
---

<Base lang={lang} title={t.title} description={t.description}>
  <section class="section">
    <div class="wrap">
      <h1>{t.title}</h1>
      <p class="lead">{t.lead}</p>
      <dl class="services">
        {t.items.map((s) => (
          <div>
            <dt>{s.name}</dt>
            <dd>{s.text}</dd>
          </div>
        ))}
      </dl>
      <h2>{t.advantageTitle}</h2>
      <dl class="services">
        {t.advantages.map((a) => (
          <div>
            <dt>{a.name}</dt>
            <dd>{a.text}</dd>
          </div>
        ))}
      </dl>
      <a class="button" href={localePath(lang, "/contact/")}>
        {t.cta}
      </a>
    </div>
  </section>
</Base>

<style>
  .services {
    margin: 2.5rem 0;
    border-top: 4px solid var(--accent);
  }
  .services div {
    display: grid;
    grid-template-columns: minmax(12rem, 22rem) 1fr;
    gap: 0.5rem 2.5rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }
  h2 {
    margin-top: 4rem;
    font-size: var(--step-2);
  }
  dt {
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.2;
  }
  dd {
    margin: 0;
    max-width: var(--measure);
  }
  @media (max-width: 40rem) {
    .services div {
      grid-template-columns: 1fr;
    }
  }
</style>
