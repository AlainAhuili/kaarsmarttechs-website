---
import Icon from "./Icon.astro";
import { LANGS, localePath, useDict, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  /** Current page without the language prefix, e.g. "/projects/". */
  path: string;
}
const { lang, path } = Astro.props;
const t = useDict(lang);
const links = [
  { href: localePath(lang, "/projects/"), label: t.nav.projects },
  { href: localePath(lang, "/services/"), label: t.nav.services },
  { href: localePath(lang, "/#about"), label: t.nav.about },
];
const contact = localePath(lang, "/contact/");
const current = Astro.url.pathname;
---

<header class="site-header" id="site-header">
  <div class="wrap bar">
    <a class="brand" href={localePath(lang, "/")} aria-label={t.nav.home}>
      <span class="mark">
        <img src="/logo.png" width="113" height="96" alt="" />
      </span>
      <span class="name">
        <span class="name-main">Kaar</span>
        <span class="name-sub">Smart Techs</span>
      </span>
    </a>
    <!-- Shown by the script below; without JavaScript the menu is always visible. -->
    <button
      class="menu-toggle"
      type="button"
      aria-controls="site-menu"
      aria-expanded="false"
      hidden
    >
      <Icon name="menu" size={28} />
      <span class="visually-hidden">{t.nav.menu}</span>
    </button>
    <div class="menu" id="site-menu">
      <nav aria-label={t.nav.main}>
        <ul>
          {links.map((l) => (
            <li>
              <a href={l.href} aria-current={current.startsWith(l.href) ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a
        class="button cta"
        href={contact}
        aria-current={current.startsWith(contact) ? "page" : undefined}
      >
        {t.nav.cta}
      </a>
      <ul class="langs" aria-label={t.nav.language}>
        {LANGS.map((l) => {
          const meta = useDict(l).meta;
          return (
            <li>
              <a
                href={localePath(l, path)}
                hreflang={l}
                lang={l}
                aria-current={l === lang ? "true" : undefined}
              >
                <span aria-hidden="true">{meta.short}</span>
                <span class="visually-hidden">{meta.name}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("site-header")!;
  const toggle = header.querySelector<HTMLButtonElement>(".menu-toggle")!;

  toggle.hidden = false;
  header.dataset.menu = "closed";
  toggle.addEventListener("click", () => {
    const open = header.dataset.menu !== "open";
    header.dataset.menu = open ? "open" : "closed";
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--rule);
    background: rgb(3 7 18 / 0.8);
    backdrop-filter: blur(12px);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 0.9rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    font-family: var(--display);
    text-transform: uppercase;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    padding: 0.3rem;
    border-radius: 0.75rem;
    background: var(--surface);
    border: 1px solid rgb(6 182 212 / 0.3);
    box-shadow: var(--glow);
    transition: transform 0.2s;
  }
  .brand:hover .mark {
    transform: scale(1.05);
  }
  .mark img {
    width: 100%;
    height: auto;
  }
  .name {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .name-main {
    color: var(--heading);
    font-weight: 800;
    font-size: 1.5rem;
    letter-spacing: 0.08em;
  }
  .name-sub {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    margin-top: 0.3rem;
  }
  .menu {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2rem);
  }
  ul {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--text);
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 500;
    transition: color 0.2s;
  }
  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--accent);
  }
  .cta {
    font-size: var(--step--1);
    padding: 0.6rem 1.2rem;
  }
  .langs {
    gap: 0.15rem;
    padding: 0.2rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
  }
  .langs a {
    display: block;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
  }
  .langs a:hover {
    color: var(--heading);
  }
  .langs a[aria-current="true"] {
    background: rgb(6 182 212 / 0.15);
    color: var(--accent);
  }
  .menu-toggle {
    display: none;
    background: none;
    border: 0;
    padding: 0.25rem;
    color: var(--text);
    cursor: pointer;
  }
  .menu-toggle:hover {
    color: var(--heading);
  }
  @media (max-width: 48rem) {
    .menu-toggle:not([hidden]) {
      display: block;
    }
    .menu {
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      padding-bottom: 0.5rem;
    }
    .site-header[data-menu="closed"] .menu {
      display: none;
    }
    nav ul {
      flex-direction: column;
      gap: 0;
    }
    .langs {
      align-self: flex-start;
    }
    nav a {
      display: block;
      padding-block: 0.6rem;
      font-size: var(--step-0);
    }
  }
</style>
