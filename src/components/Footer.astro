---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap cols">
    <div>
      <p class="name">Kaar Smart Techs</p>
      <p>
        Vision, embedded and cloud systems.
        <br />
        Delmenhorst, Germany
      </p>
    </div>
    <p class="tagline">"Innovating Tomorrow, Connected Today"</p>
    <nav aria-label="Legal">
      <a href="/impressum/">Impressum</a>
      <a href="/datenschutz/">Privacy policy</a>
      <a href="/contact/">Contact</a>
    </nav>
  </div>
  <div class="wrap fine">
    <p>
      &copy; {year} Kaar Smart Techs. LEGO&reg; is a trademark of the LEGO Group, which does not
      sponsor, authorise or endorse this website.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg);
    border-top: 1px solid var(--rule);
    color: var(--muted);
    padding-block: 3rem 1.5rem;
  }
  .cols {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .name {
    font-family: var(--display);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--heading);
    font-size: 1.1rem;
    margin-bottom: 0.4rem;
  }
  .tagline {
    font-style: italic;
    font-weight: 500;
    color: var(--accent);
  }
  nav {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  a {
    color: var(--text);
  }
  a:hover {
    color: var(--accent);
  }
  .fine {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font-size: var(--step--1);
  }
</style>
