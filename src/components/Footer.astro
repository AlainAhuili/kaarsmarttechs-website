---
import { localePath, useDict, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useDict(lang).footer;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap cols">
    <div>
      <p class="name">Kaar Smart Techs</p>
      <p>
        {t.blurb}
        <br />
        {t.place}
      </p>
    </div>
    <!-- The motto stays in English in every language. -->
    <p class="tagline" lang="en">
      "Innovating Tomorrow, Connected Today"
    </p>
    <nav aria-label={t.legal}>
      <a href={localePath(lang, "/impressum/")}>{t.impressum}</a>
      <a href={localePath(lang, "/datenschutz/")}>{t.privacy}</a>
      <a href={localePath(lang, "/contact/")}>{t.contact}</a>
    </nav>
  </div>
  <div class="wrap fine">
    <p>
      &copy; {year} Kaar Smart Techs. {t.lego}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg);
    border-top: 1px solid var(--rule);
    color: var(--muted);
    padding-block: 3rem 1.5rem;
  }
  .cols {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .name {
    font-family: var(--display);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--heading);
    font-size: 1.1rem;
    margin-bottom: 0.4rem;
  }
  .tagline {
    font-style: italic;
    font-weight: 500;
    color: var(--accent);
  }
  nav {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  a {
    color: var(--text);
  }
  a:hover {
    color: var(--accent);
  }
  .fine {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    font-size: var(--step--1);
  }
</style>
