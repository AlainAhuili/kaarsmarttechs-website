---
import type { CollectionEntry } from "astro:content";
import { categorySlug } from "../lib/projects";

interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const { title, tagline, status, categories, stack } = project.data;
---

<li class="row" data-categories={categories.map(categorySlug).join(" ")}>
  <div class="meta">
    <span class="status">{status}</span>
    <span class="cats">{categories.join(", ")}</span>
  </div>
  <div class="body">
    <h3>
      <a href={`/projects/${project.id}/`}>{title}</a>
    </h3>
    <p>{tagline}</p>
    <p class="stack">Built with {stack.slice(0, 5).join(", ")}</p>
  </div>
</li>

<style>
  .row {
    display: grid;
    grid-template-columns: minmax(10rem, 14rem) 1fr;
    gap: 1rem 2.5rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--rule);
  }
  .row[hidden] {
    display: none;
  }
  .status {
    display: inline-block;
    font-weight: 500;
    font-size: var(--step--1);
    padding: 0.1rem 0.5rem;
    border-left: 4px solid var(--signal);
    background: var(--panel);
  }
  .cats {
    display: block;
    margin-top: 0.5rem;
    color: var(--steel);
    font-size: var(--step--1);
  }
  h3 {
    margin-bottom: 0.35rem;
  }
  h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 3px;
  }
  p {
    margin-bottom: 0.35rem;
  }
  .stack {
    color: var(--steel);
    font-size: var(--step--1);
  }
  @media (max-width: 40rem) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
