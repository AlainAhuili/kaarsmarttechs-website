---
// Animated conveyor: bricks pass the camera and are pushed into the bin for their colour.
// With reduced motion, the bricks rest on the belt at their static positions.
import { useDict, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const t = useDict(Astro.props.lang).sorter;
const bins = [
  { x: 330, label: t.bins[0], color: "var(--accent)" },
  { x: 560, label: t.bins[1], color: "#f2b705" },
  { x: 790, label: t.bins[2], color: "var(--accent-blue)" },
];
// static x on the belt, target bin index, animation delay (s)
const bricks = [
  { sx: 40, bin: 0, delay: 0 },
  { sx: 120, bin: 2, delay: 1.2 },
  { sx: 200, bin: 1, delay: 2.4 },
  { sx: 420, bin: 0, delay: 3.6 },
  { sx: 650, bin: 1, delay: 4.8 },
  { sx: 860, bin: 2, delay: 6 },
];
---

<figure class="sorter">
  <svg viewBox="0 0 1000 370" role="img" aria-labelledby="sorter-title">
    <title id="sorter-title">{t.title}</title>

    <!-- camera and scan beam -->
    <polygon points="165,62 195,62 225,150 135,150" fill="var(--accent)" opacity="0.2"></polygon>
    <rect
      x="150"
      y="30"
      width="60"
      height="34"
      fill="var(--raised)"
      stroke="var(--muted)"
      stroke-width="2"
    ></rect>
    <circle cx="180" cy="47" r="9" fill="var(--accent)"></circle>
    <circle cx="180" cy="47" r="4" fill="var(--bg)"></circle>
    <line x1="180" y1="0" x2="180" y2="30" stroke="var(--muted)" stroke-width="4"></line>

    <!-- ejectors -->
    {bins.map((b) => (
      <g>
        <line x1={b.x} y1="70" x2={b.x} y2="104" stroke="var(--muted)" stroke-width="4" />
        <rect x={b.x - 14} y="104" width="28" height="12" fill="var(--muted)" />
      </g>
    ))}

    <!-- belt -->
    <rect x="0" y="156" width="1000" height="16" fill="#192e5b"></rect>
    <g class="belt-marks" fill="var(--accent)">
      {Array.from({ length: 27 }, (_, i) => (
        <rect x={i * 40 - 40} y="162" width="18" height="4" />
      ))}
    </g>
    {Array.from({ length: 11 }, (_, i) => (
      <circle cx={20 + i * 96} cy="184" r="10" fill="none" stroke="var(--muted)" stroke-width="3" />
    ))}

    <!-- bins -->
    {bins.map((b) => (
      <g>
        <path
          d={`M${b.x - 70} 240 L${b.x - 58} 320 L${b.x + 58} 320 L${b.x + 70} 240`}
          fill="var(--surface)"
          stroke="var(--muted)"
          stroke-width="3"
        />
        <rect x={b.x - 58} y="312" width="116" height="8" fill={b.color} />
        <text x={b.x} y="352" text-anchor="middle" class="bin-label">
          {b.label}
        </text>
      </g>
    ))}

    <!-- bricks -->
    {bricks.map((k) => {
      const target = bins[k.bin]!;
      return (
        <g
          class="brick"
          transform={`translate(${k.sx} 124)`}
          style={`--x:${target.x - 24}px; animation-delay:${k.delay}s`}
        >
          <rect x="0" y="8" width="48" height="24" fill={target.color} />
          <rect x="7" y="2" width="12" height="6" fill={target.color} />
          <rect x="29" y="2" width="12" height="6" fill={target.color} />
        </g>
      );
    })}
  </svg>
</figure>

<style>
  .sorter {
    margin: 0;
    overflow: hidden;
  }
  svg {
    display: block;
    width: 100%;
    min-width: 600px;
  }
  .bin-label {
    font-family: var(--display);
    font-weight: 700;
    font-size: 22px;
    fill: var(--text);
  }
  @media (prefers-reduced-motion: no-preference) {
    .brick {
      animation: sort 7.2s linear infinite backwards;
    }
    .belt-marks {
      animation: belt 0.9s linear infinite;
    }
  }
  @keyframes sort {
    0% {
      transform: translate(-60px, 124px);
      opacity: 0;
    }
    6% {
      opacity: 1;
    }
    62% {
      transform: translate(var(--x), 124px);
    }
    74% {
      transform: translate(var(--x), 270px);
    }
    92% {
      opacity: 1;
    }
    100% {
      transform: translate(var(--x), 270px);
      opacity: 0;
    }
  }
  @keyframes belt {
    to {
      transform: translateX(40px);
    }
  }
</style>
