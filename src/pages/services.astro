---
import Base from "../layouts/Base.astro";

const services = [
  {
    name: "Vision and inspection systems",
    text: "Camera setup, lighting, OpenCV pipelines and classification models for detecting, counting and sorting objects.",
  },
  {
    name: "Embedded software",
    text: "C++ and C# software for controllers, sensors and actuators, built for reliability on constrained hardware.",
  },
  {
    name: "Cloud platform and delivery pipelines",
    text: "Infrastructure as code with Terraform, containerised services on Kubernetes and AWS, and CI/CD with approval gates.",
  },
  {
    name: "Code quality audits",
    text: "Static analysis and test gates for C++, Python and TypeScript repositories, set up and tuned for your codebase.",
  },
  {
    name: "Agentic tooling and MCP integrations",
    text: "Model Context Protocol servers that connect AI assistants to your data and machines, with human confirmation where it matters.",
  },
];
---

<Base
  title="Services"
  description="Engineering services from Kaar Smart Techs: vision systems, embedded software, cloud platforms, code quality audits and MCP integrations."
>
  <section class="section">
    <div class="wrap">
      <h1>Services</h1>
      <p class="lead">
        We take on projects where software meets hardware, or where delivery needs to be automated.
      </p>
      <dl class="services">
        {services.map((s) => (
          <div>
            <dt>{s.name}</dt>
            <dd>{s.text}</dd>
          </div>
        ))}
      </dl>
      <a class="button" href="/contact/">
        Discuss your project
      </a>
    </div>
  </section>
</Base>

<style>
  .services {
    margin: 2.5rem 0;
    border-top: 4px solid var(--accent);
  }
  .services div {
    display: grid;
    grid-template-columns: minmax(12rem, 22rem) 1fr;
    gap: 0.5rem 2.5rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }
  dt {
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.2;
  }
  dd {
    margin: 0;
    max-width: var(--measure);
  }
  @media (max-width: 40rem) {
    .services div {
      grid-template-columns: 1fr;
    }
  }
</style>
