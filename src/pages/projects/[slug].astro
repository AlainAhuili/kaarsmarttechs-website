---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, tagline, status, categories, problem, stack, metrics } = project.data;
---

<Base title={title} description={tagline}>
  <article class="section">
    <div class="wrap">
      <p class="crumb">
        <a href="/projects/">Projects</a>
      </p>
      <h1>{title}</h1>
      <p class="lead">{tagline}</p>

      <dl class="facts">
        <div>
          <dt>Status</dt>
          <dd>{status}</dd>
        </div>
        <div>
          <dt>Categories</dt>
          <dd>{categories.join(", ")}</dd>
        </div>
        <div>
          <dt>Built with</dt>
          <dd>{stack.join(", ")}</dd>
        </div>
      </dl>

      <div class="prose">
        <h2>The problem</h2>
        <p>{problem}</p>
        <Content />
      </div>

      {metrics.length > 0 && (
        <section class="metrics" aria-labelledby="results">
          <h2 id="results">Results</h2>
          <p>We publish measured numbers only. Open values are still being measured.</p>
          <dl>
            {metrics.map((m) => (
              <div class={m.value ? "" : "pending"}>
                <dt>{m.label}</dt>
                <dd>{m.value ?? "Measuring"}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      <p class="next">
        <a class="button" href="/contact/">
          Talk to us about a similar project
        </a>
      </p>
    </div>
  </article>
</Base>

<style>
  .crumb {
    font-size: var(--step--1);
  }
  h1 {
    font-size: var(--step-3);
    max-width: 20ch;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    margin: 2rem 0;
    border-top: 4px solid var(--signal);
    border-bottom: 1px solid var(--rule);
  }
  .facts div,
  .metrics dl div {
    padding: 0.9rem 1.25rem 0.9rem 0;
  }
  dt {
    color: var(--steel);
    font-size: var(--step--1);
  }
  dd {
    margin: 0.2rem 0 0;
    font-weight: 500;
  }
  .metrics {
    margin-top: 3rem;
  }
  .metrics h2 {
    font-size: var(--step-2);
  }
  .metrics dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  .metrics dl div {
    background: var(--panel);
    padding: 1.25rem;
  }
  .metrics dd {
    font-family: var(--display);
    font-variation-settings: "wdth" 125;
    font-weight: 800;
    font-size: var(--step-2);
  }
  .metrics .pending dd {
    color: var(--steel);
    font-size: var(--step-1);
    font-weight: 600;
  }
  .next {
    margin-top: 3rem;
  }
</style>
