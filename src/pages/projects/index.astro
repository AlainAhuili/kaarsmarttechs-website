---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProjectRow from "../../components/ProjectRow.astro";
import { CATEGORIES, categorySlug, sortProjects } from "../../lib/projects";

const projects = sortProjects(await getCollection("projects"));
---

<Base
  title="Projects"
  description="Projects by Kaar Smart Techs in computer vision, embedded systems, cloud and DevOps, and agentic tooling."
>
  <section class="section">
    <div class="wrap">
      <h1>Projects</h1>
      <p class="lead">
        What we are building, with an honest status on each one. Results are published once they are
        measured.
      </p>

      <div class="filters" role="group" aria-label="Filter projects by category">
        <button type="button" data-filter="all" aria-pressed="true">
          All
        </button>
        {CATEGORIES.map((c) => (
          <button type="button" data-filter={categorySlug(c)} aria-pressed="false">
            {c}
          </button>
        ))}
      </div>
      <p class="count" aria-live="polite" id="count">
        {projects.length} projects
      </p>

      <ul class="rows" id="project-list">
        {projects.map((p) => (
          <ProjectRow project={p} />
        ))}
      </ul>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const rows = document.querySelectorAll<HTMLLIElement>("#project-list > li");
  const count = document.getElementById("count")!;

  buttons.forEach((btn) =>
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter!;
      let shown = 0;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      rows.forEach((row) => {
        const match = filter === "all" || row.dataset.categories!.split(" ").includes(filter);
        row.hidden = !match;
        if (match) shown++;
      });
      count.textContent = `${shown} ${shown === 1 ? "project" : "projects"}`;
    }),
  );
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }
  .filters button {
    font: inherit;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--rule);
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    cursor: pointer;
  }
  .filters button[aria-pressed="true"] {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }
  .count {
    color: var(--muted);
    font-size: var(--step--1);
    margin-top: 1rem;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }
</style>
