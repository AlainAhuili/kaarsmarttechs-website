---
import ProjectsPage from "../../../views/ProjectsPage.astro";
import { PREFIXED_LANGS, type Lang } from "../../../i18n";

export function getStaticPaths() {
  return PREFIXED_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<ProjectsPage lang={lang} />
