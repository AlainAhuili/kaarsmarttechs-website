---
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import type { ComponentProps } from "astro/types";
import Icon from "../components/Icon.astro";
import SorterLine from "../components/SorterLine.astro";

type IconName = ComponentProps<typeof Icon>["name"];

const email = "hello@kaarsmarttechs.com";

const stats = [
  { value: "Edge AI", label: "Processing where machines run" },
  { value: "100%", label: "On-device autonomy" },
  { value: "NPU · Jetson", label: "Embedded targets" },
  { value: "Germany", label: "Delmenhorst hub" },
];

// The four technical pillars, shown as cards under the hero.
const capabilities = [
  {
    icon: "eye",
    name: "Vision and inspection systems",
    text: "Low-latency OpenCV pipelines, camera setups and custom classification models for real-time work such as high-speed part sorting and 3D precision welding robotics.",
  },
  {
    icon: "chip",
    name: "Embedded and systems engineering",
    text: "Lightweight, energy-efficient C++ and C# software running directly on constrained targets (NPU, Jetson and specialised microcontrollers) for predictable real-time performance.",
  },
  {
    icon: "network",
    name: "Agentic AI and MCP integrations",
    text: "Secure Model Context Protocol servers connecting AI assistants, RAG diagnostic tools and local equipment, without compromising your IP or network autonomy.",
  },
  {
    icon: "cloud",
    name: "Hybrid cloud and delivery pipelines",
    text: "Enterprise-grade cloud architecture with Terraform, Kubernetes and AWS, and continuous integration with strict code-quality gates.",
  },
] satisfies { icon: IconName; name: string; text: string }[];

// The four projects featured on the home page, with a short list of highlights each.
const featured = await Promise.all(
  (
    [
      {
        id: "lego-sorting-system",
        icon: "cube",
        tag: "Automation & AI",
        highlights: [
          "Real-time image recognition and bounding boxes",
          "Mechanical conveyor and sorting feeder",
          "Custom microcontroller and motor integration",
        ],
      },
      {
        id: "travel-hygienic-wc-seat-frame",
        icon: "hygiene",
        tag: "Smart Health & Utility",
        highlights: [
          "Compact folding architecture for transit",
          "Touch-free UV-C disinfection module",
          "Lightweight metal frame",
        ],
      },
      {
        id: "solar-led-wireframe-sculptures",
        icon: "solar",
        tag: "Sustainable Art & Tech",
        highlights: [
          "Miniature photovoltaic cells",
          "Weatherproof welded wireframe structures",
          "Dusk-to-dawn lighting control",
        ],
      },
      {
        id: "embedded-vision-toolkit",
        icon: "network",
        tag: "Embedded Vision",
        highlights: [
          "Camera capture and lighting normalisation",
          "Segmentation and on-device inference",
          "Reusable C++ modules with a stable interface",
        ],
      },
    ] satisfies { id: string; icon: IconName; tag: string; highlights: string[] }[]
  ).map(async (f) => ({ ...f, project: (await getEntry("projects", f.id))! })),
);

// What processing at the edge gives the client, from the mission statement.
const values = [
  {
    name: "No cloud latency",
    text: "Data is processed right where machines and sensors operate, so decisions happen in real time.",
  },
  {
    name: "Lower infrastructure costs",
    text: "Less data shipped to and stored in the cloud means smaller bills and simpler infrastructure.",
  },
  {
    name: "Reliability without compromise",
    text: "Maximum operational reliability, with sensitive production data kept on site.",
  },
];
---

<Base
  title="Kaar Smart Techs"
  description="Kaar Smart Techs bridges software and hardware with Edge AI, embedded systems and robust cloud infrastructure. Based in Delmenhorst, Germany."
>
  <section class="hero" id="hero">
    <div class="orb orb-a"></div>
    <div class="orb orb-b"></div>
    <div class="wrap hero-inner">
      <div class="emblem">
        <img src="/logo.png" width="113" height="96" alt="" />
      </div>
      <p class="badge">
        <Icon name="chip" size={16} />
        Edge AI, embedded systems and cloud infrastructure
      </p>
      <h1>
        Kaar <span class="gradient">Smart Techs</span>
      </h1>
      <p class="motto">"Innovating Tomorrow, Connected Today"</p>
      <p class="intro">
        We bridge high-performance software with hardware. By processing data at the edge, right
        where machines and sensors operate, our solutions eliminate cloud latency, cut
        infrastructure costs and deliver maximum reliability without sacrificing data security.
      </p>
      <div class="actions">
        <a class="button" href="#capabilities">
          Explore capabilities <Icon name="arrow" size={18} />
        </a>
        <a class="button secondary" href="/contact/">
          Partner with us
        </a>
      </div>
      <div class="line">
        <SorterLine />
      </div>
      <ul class="stats">
        {stats.map((s) => (
          <li>
            <strong>{s.value}</strong>
            <span>{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="capabilities">
    <div class="wrap">
      <div class="heading">
        <p class="eyebrow">Key technical pillars</p>
        <h2>From the sensor to the cloud</h2>
        <p>
          Four disciplines, delivered by one team, so vision, embedded code, AI tooling and
          infrastructure fit together from day one.
        </p>
      </div>
      <ul class="cards capabilities">
        {capabilities.map((c) => (
          <li class="card">
            <div class="card-body">
              <span class="icon">
                <Icon name={c.icon} size={28} />
              </span>
              <h3>{c.name}</h3>
              <p>{c.text}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="all">
        <a href="/services/">How we work with you</a>
      </p>
    </div>
  </section>

  <section class="section band" id="innovations">
    <div class="wrap">
      <div class="heading">
        <p class="eyebrow">Our core portfolio</p>
        <h2>Where software meets hardware</h2>
        <p>
          What we are building, from vision-guided sorting and embedded inspection to smart utility
          products and solar installations, with an honest status on each one.
        </p>
      </div>
      <ul class="cards">
        {featured.map(({ project, icon, tag, highlights }) => (
          <li class="card">
            <div class="card-body">
              <div class="card-top">
                <span class="icon">
                  <Icon name={icon} size={28} />
                </span>
                <span class="tag">{tag}</span>
              </div>
              <h3>
                <a href={`/projects/${project.id}/`}>{project.data.title}</a>
              </h3>
              <p>{project.data.tagline}</p>
              <ul class="highlights">
                {highlights.map((h) => (
                  <li>
                    <Icon name="check" size={16} />
                    {h}
                  </li>
                ))}
              </ul>
            </div>
            <div class="card-foot">
              <span>Status: {project.data.status}</span>
              <span class="more" aria-hidden="true">
                Case study <Icon name="chevron" size={14} />
              </span>
            </div>
          </li>
        ))}
      </ul>
      <p class="all">
        <a href="/projects/">See all projects</a>
      </p>
    </div>
  </section>

  <section class="section" id="about">
    <div class="wrap about">
      <div>
        <p class="eyebrow">About Kaar Smart Techs</p>
        <h2>Rooted in Delmenhorst, engineering for the globe</h2>
        <p>
          Kaar Smart Techs bridges high-performance software with hardware through localised
          processing (Edge AI), embedded systems and robust cloud infrastructure. Working from{" "}
          <strong>Delmenhorst, Lower Saxony, Germany</strong>, we combine German engineering
          discipline with creative, future-proof design.
        </p>
        <p>
          Whether we are building automated sorting machines, vision-guided robotics or secure AI
          integrations, our commitment stays the same:{" "}
          <em class="accent">"Innovating Tomorrow, Connected Today"</em>.
        </p>
        <h3 class="advantage">Strategic advantage</h3>
        <div class="pillars">
          <div>
            <Icon name="shield" />
            <div>
              <h3>100% on-device autonomy</h3>
              <p>
                No dependency on a constant internet connection, so critical machinery keeps running
                through network disruptions.
              </p>
            </div>
          </div>
          <div>
            <Icon name="bolt" />
            <div>
              <h3>Turnkey engineering</h3>
              <p>
                Full-lifecycle delivery, from quantised model deployment and hardware optimisation
                to audit-ready codebases.
              </p>
            </div>
          </div>
        </div>
      </div>
      <div class="values-wrap">
        <div class="values">
          <h3>
            <Icon name="target" /> Core mission and value
          </h3>
          <dl>
            {values.map((v) => (
              <div>
                <dt>{v.name}</dt>
                <dd>{v.text}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="section band" id="contact">
    <div class="wrap">
      <div class="heading">
        <p class="eyebrow">Get in touch</p>
        <h2>Let's build the future together</h2>
        <p>
          Have a project inquiry or a collaboration proposal, or want to explore our technologies?
          Reach out to our Delmenhorst team.
        </p>
      </div>
      <div class="contact">
        <ul class="contact-cards">
          <li>
            <span class="icon">
              <Icon name="pin" size={20} />
            </span>
            <div>
              <h3>Headquarters</h3>
              <p>
                Delmenhorst, Lower Saxony
                <br />
                Germany
              </p>
            </div>
          </li>
          <li>
            <span class="icon">
              <Icon name="mail" size={20} />
            </span>
            <div>
              <h3>Email us</h3>
              <p>
                <a href={`mailto:${email}`}>{email}</a>
              </p>
            </div>
          </li>
          <li>
            <span class="icon">
              <Icon name="globe" size={20} />
            </span>
            <div>
              <h3>Response time</h3>
              <p>We reply within two working days.</p>
            </div>
          </li>
        </ul>
        <div class="contact-panel">
          <h3>Tell us about your project</h3>
          <p>
            Describe what you want to detect, sort or automate, and roughly when you need it. We'll
            get back to you with next steps.
          </p>
          <a class="button" href={`mailto:${email}`}>
            Send us a message <Icon name="send" size={18} />
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------------------------------------------------------------- hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 10vw, 8rem) clamp(4rem, 9vw, 7rem);
    text-align: center;
    background-image:
      radial-gradient(circle at 50% 50%, rgb(6 182 212 / 0.05) 0%, transparent 80%),
      linear-gradient(to right, rgb(255 255 255 / 0.02) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.02) 1px, transparent 1px);
    background-size:
      100% 100%,
      40px 40px,
      40px 40px;
  }
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(64px);
    pointer-events: none;
  }
  .orb-a {
    top: 25%;
    left: 50%;
    width: 24rem;
    height: 24rem;
    transform: translate(-50%, -50%);
    background: rgb(6 182 212 / 0.1);
  }
  .orb-b {
    bottom: 2.5rem;
    right: 2.5rem;
    width: 20rem;
    height: 20rem;
    background: rgb(37 99 235 / 0.1);
  }
  .hero-inner {
    position: relative;
  }
  .emblem {
    display: inline-block;
    margin-bottom: 2rem;
    padding: 0.75rem;
    border-radius: var(--radius);
    background: rgb(10 17 40 / 0.8);
    border: 1px solid rgb(6 182 212 / 0.4);
    box-shadow: var(--glow);
  }
  .emblem img {
    display: block;
    width: clamp(5.5rem, 14vw, 7rem);
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: none;
    margin: 0 auto 1.5rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: rgb(6 182 212 / 0.1);
    border: 1px solid rgb(6 182 212 / 0.3);
    color: var(--accent);
    font-size: var(--step--1);
    font-weight: 600;
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.6;
    }
  }
  h1 {
    font-size: clamp(2.5rem, 8vw, 4.75rem);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }
  .gradient {
    background: linear-gradient(to right, var(--accent), var(--accent-blue));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .motto {
    max-width: none;
    margin-bottom: 2rem;
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    font-weight: 300;
    font-style: italic;
    letter-spacing: 0.02em;
    color: #67e8f9;
  }
  .intro {
    max-width: 48rem;
    margin: 0 auto 2.5rem;
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: var(--muted);
  }
  .intro strong {
    color: var(--heading);
    font-weight: 500;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
  .line {
    max-width: 64rem;
    margin: clamp(2.5rem, 6vw, 4rem) auto 0;
  }
  .stats {
    list-style: none;
    margin: clamp(2.5rem, 6vw, 4rem) auto 0;
    padding: 0;
    max-width: 64rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .stats li {
    padding: 1.5rem;
    border-radius: var(--radius);
    background: rgb(10 17 40 / 0.6);
    border: 1px solid var(--rule);
    backdrop-filter: blur(4px);
  }
  .stats strong {
    display: block;
    margin-bottom: 0.25rem;
    font-size: clamp(1.6rem, 3.5vw, 2.25rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--accent);
  }
  .stats span {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--muted);
  }

  /* ------------------------------------------------------- shared section */
  .band {
    background: rgb(10 17 40 / 0.5);
  }
  .heading {
    max-width: 48rem;
    margin: 0 auto 4rem;
    text-align: center;
  }
  .heading p:last-child {
    margin-inline: auto;
    font-size: 1.125rem;
    color: var(--muted);
  }
  .eyebrow {
    margin-bottom: 0.75rem;
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h2 {
    font-size: clamp(1.9rem, 4.5vw, 3rem);
  }
  .icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius);
    background: rgb(6 182 212 / 0.1);
    border: 1px solid rgb(6 182 212 / 0.3);
    color: var(--accent);
  }

  /* ---------------------------------------------------------- portfolio */
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    border-radius: 1.5rem;
    background: var(--bg);
    border: 1px solid var(--rule);
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.3);
    transition: border-color 0.3s;
  }
  .card:hover,
  .card:focus-within {
    border-color: rgb(6 182 212 / 0.5);
  }
  .card-body {
    padding: 2rem;
  }
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .card .icon {
    transition: transform 0.3s;
  }
  .card:hover .icon {
    transform: scale(1.1);
  }
  .tag {
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: rgb(6 182 212 / 0.1);
    border: 1px solid rgb(6 182 212 / 0.2);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: right;
  }
  .card h3 {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .card h3 a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }
  /* The whole card is clickable through the title link. */
  .card h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .card:hover h3 a {
    color: var(--accent);
  }
  .card-body > p {
    font-size: var(--step--1);
    color: var(--muted);
    margin-bottom: 1.5rem;
  }
  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    font-size: var(--step--1);
  }
  .highlights li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .highlights :global(svg) {
    flex-shrink: 0;
    color: var(--accent);
  }
  .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 2rem;
    background: var(--surface);
    border-top: 1px solid var(--rule);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--muted);
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--accent);
  }
  .all {
    margin: 2.5rem 0 0;
    max-width: none;
    text-align: center;
  }

  /* ------------------------------------------------------- capabilities */
  .capabilities .card {
    background: var(--surface);
  }
  .capabilities .icon {
    margin-bottom: 1.5rem;
  }
  .capabilities .card-body > p {
    margin-bottom: 0;
  }

  /* -------------------------------------------------------------- about */
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .about > div > p:not(.eyebrow) {
    color: var(--muted);
  }
  .about strong {
    color: var(--heading);
    font-weight: 600;
  }
  .accent {
    color: #67e8f9;
  }
  .advantage {
    margin: 2rem 0 0;
    font-size: var(--step--1);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .pillars {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 1rem;
  }
  .pillars > div {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .pillars :global(svg) {
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: var(--accent);
  }
  .pillars h3,
  .contact-cards h3 {
    font-size: var(--step--1);
    letter-spacing: 0;
    margin-bottom: 0.25rem;
  }
  .pillars p,
  .contact-cards p {
    margin: 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .values-wrap {
    position: relative;
  }
  .values-wrap::before {
    content: "";
    position: absolute;
    inset: -0.25rem;
    border-radius: 1.5rem;
    background: linear-gradient(to right, #06b6d4, #2563eb);
    opacity: 0.3;
    filter: blur(16px);
  }
  .values {
    position: relative;
    padding: clamp(2rem, 4vw, 2.5rem);
    border-radius: 1.5rem;
    background: var(--surface);
    border: 1px solid rgb(100 116 139 / 0.35);
    box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.5);
  }
  .values h3 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.25rem;
    letter-spacing: 0;
    margin-bottom: 1.5rem;
  }
  .values h3 :global(svg) {
    color: var(--accent);
  }
  .values dl {
    margin: 0;
  }
  .values dl div {
    padding-block: 1rem;
    border-bottom: 1px solid var(--rule);
  }
  .values dl div:first-child {
    padding-top: 0;
  }
  .values dl div:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }
  dt {
    margin-bottom: 0.25rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--heading);
  }
  dd {
    margin: 0;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* ------------------------------------------------------------ contact */
  .contact {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
  }
  .contact-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }
  .contact-cards li {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--bg);
    border: 1px solid var(--rule);
  }
  .contact-cards .icon {
    width: 3rem;
    height: 3rem;
    border-radius: 0.75rem;
  }
  .contact-panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(2rem, 5vw, 2.5rem);
    border-radius: 1.5rem;
    background: var(--bg);
    border: 1px solid var(--rule);
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.3);
  }
  .contact-panel h3 {
    font-size: var(--step-2);
  }
  .contact-panel p {
    color: var(--muted);
    margin-bottom: 2rem;
  }

  /* ------------------------------------------------------------- layout */
  @media (max-width: 56rem) {
    .about,
    .contact {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 48rem) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    .cards {
      grid-template-columns: 1fr;
    }
    .actions .button {
      width: 100%;
    }
  }
  @media (max-width: 30rem) {
    .pillars {
      grid-template-columns: 1fr;
    }
  }
</style>
