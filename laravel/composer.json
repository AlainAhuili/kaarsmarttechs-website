{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "kaarsmarttechs/website-laravel",
    "type": "project",
    "description": "kaarsmarttechs.com as a Laravel application backed by MySQL.",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.35",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.5.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
