#!/bin/sh
# Runs once per release, before the new app containers take traffic (the "wp-setup" service in
# docker-compose.yml). Installs WordPress on the first run, then upgrades the database, applies
# the settings and rewrite rules, and creates the legal pages if they are missing. Idempotent.
set -eu

: "${WORDPRESS_URL:?}" "${WORDPRESS_ADMIN_EMAIL:?}"

if ! wp core is-installed; then
  : "${WORDPRESS_ADMIN_PASSWORD:?Set WORDPRESS_ADMIN_PASSWORD for the first installation}"
  wp core install --skip-email \
    --url="$WORDPRESS_URL" \
    --title="Kaar Smart Techs" \
    --admin_user="${WORDPRESS_ADMIN_USER:-admin}" \
    --admin_password="$WORDPRESS_ADMIN_PASSWORD" \
    --admin_email="$WORDPRESS_ADMIN_EMAIL"
  # Sample post, sample page and the draft privacy page.
  ids="$(wp post list --post_type=post,page --post_status=any --format=ids)"
  [ -z "$ids" ] || wp post delete $ids --force
fi

wp core update-db
wp theme activate kaarsmarttechs
wp option update blogdescription ""
wp option update blog_public 1
wp option update show_on_front posts
wp option update default_comment_status closed
wp option update default_ping_status closed
wp option update show_avatars 0 # Gravatar would be a third-party request
wp option update users_can_register 0
wp option update timezone_string Europe/Berlin
wp rewrite structure '/%postname%/'
# A new release must not serve the previous release's cached API answer.
wp transient delete kaar_projects
wp eval-file /usr/local/share/kaarsmarttechs/seed-pages.php
